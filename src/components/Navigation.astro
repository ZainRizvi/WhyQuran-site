---
interface Props {
  prevPost?: {
    slug: string;
    title: string;
  };
  nextPost?: {
    slug: string;
    title: string;
  };
}

const { prevPost, nextPost } = Astro.props;

// Clean title by removing episode number prefix and truncating
function formatTitle(title: string) {
  const cleaned = title.replace(/^\[\d+\]\s*/, '');
  return cleaned.length > 50 ? cleaned.slice(0, 50) + '...' : cleaned;
}

// Extract episode number
function getEpisodeNum(title: string) {
  const match = title.match(/^\[(\d+)\]/);
  return match ? match[1] : null;
}
---

{(prevPost || nextPost) && (
  <nav class="episode-nav" aria-label="Episode navigation">
    {prevPost ? (
      <a href={`/blog/${prevPost.slug}/`} class="nav-link prev">
        <span class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </span>
        <span class="nav-content">
          <span class="nav-label">Previous Episode</span>
          <span class="nav-title">
            {getEpisodeNum(prevPost.title) && (
              <span class="nav-number">{getEpisodeNum(prevPost.title)}</span>
            )}
            {formatTitle(prevPost.title)}
          </span>
        </span>
      </a>
    ) : (
      <div class="nav-placeholder"></div>
    )}

    {nextPost ? (
      <a href={`/blog/${nextPost.slug}/`} class="nav-link next">
        <span class="nav-content">
          <span class="nav-label">Next Episode</span>
          <span class="nav-title">
            {getEpisodeNum(nextPost.title) && (
              <span class="nav-number">{getEpisodeNum(nextPost.title)}</span>
            )}
            {formatTitle(nextPost.title)}
          </span>
        </span>
        <span class="nav-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>
    ) : (
      <div class="nav-placeholder"></div>
    )}
  </nav>
)}

<style>
  .episode-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-10);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    transition: all var(--transition-base);
    border: 1px solid var(--color-border);
  }

  .nav-link:hover {
    background: var(--color-bg-alt);
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .nav-link.prev {
    justify-content: flex-start;
  }

  .nav-link.next {
    justify-content: flex-end;
    text-align: right;
  }

  .nav-placeholder {
    /* Empty placeholder to maintain grid */
  }

  .nav-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg-alt);
    border-radius: var(--radius-md);
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .nav-link:hover .nav-icon {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }

  .nav-icon svg {
    width: 20px;
    height: 20px;
  }

  .nav-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .nav-label {
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  .nav-title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
  }

  .nav-link.next .nav-title {
    justify-content: flex-end;
  }

  .nav-link:hover .nav-title {
    color: var(--color-accent);
  }

  .nav-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 24px;
    height: 24px;
    padding: 0 var(--space-2);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .episode-nav {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .nav-link.next {
      justify-content: flex-start;
      text-align: left;
    }

    .nav-link.next .nav-title {
      justify-content: flex-start;
    }

    .nav-link.next {
      flex-direction: row-reverse;
    }
  }
</style>
