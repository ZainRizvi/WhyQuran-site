---
interface Props {
  title: string;
  slug: string;
  date: Date;
  youtubeId?: string;
}

const { title, slug, date, youtubeId } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

// Extract episode number from title like "[1] Title"
const episodeMatch = title.match(/^\[(\d+)\]/);
const episodeNum = episodeMatch ? episodeMatch[1] : null;
const cleanTitle = title.replace(/^\[\d+\]\s*/, '');
---

<article class="post-card">
  <a href={`/blog/${slug}/`} class="card-link">
    {youtubeId && (
      <div class="card-thumbnail">
        <img
          src={`https://img.youtube.com/vi/${youtubeId}/mqdefault.jpg`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <div class="thumbnail-overlay">
          <span class="play-icon">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </span>
        </div>
        {episodeNum && <span class="episode-badge">{episodeNum}</span>}
      </div>
    )}
    <div class="card-body">
      <h3 class="card-title">{cleanTitle}</h3>
      <time class="card-date" datetime={date.toISOString()}>
        {formattedDate}
      </time>
    </div>
  </a>
</article>

<style>
  .post-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary);
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .post-card:hover .card-thumbnail img {
    transform: scale(1.05);
  }

  .thumbnail-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 31, 58, 0.3);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .post-card:hover .thumbnail-overlay {
    opacity: 1;
  }

  .play-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    border-radius: 50%;
    color: white;
    transform: scale(0.8);
    transition: transform var(--transition-bounce);
  }

  .post-card:hover .play-icon {
    transform: scale(1);
  }

  .play-icon svg {
    width: 22px;
    height: 22px;
    margin-left: 2px;
  }

  .episode-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    min-width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }

  .card-body {
    padding: var(--space-4) var(--space-5);
  }

  .card-title {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.4;
    margin: 0 0 var(--space-2);
    color: var(--color-text);
    transition: color var(--transition-fast);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card:hover .card-title {
    color: var(--color-accent);
  }

  .card-date {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }
</style>
