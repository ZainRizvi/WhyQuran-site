---
const currentYear = new Date().getFullYear();

const socialLinks = [
  {
    name: 'YouTube',
    href: 'https://www.youtube.com/@WhyQuran',
    icon: 'M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z'
  },
  {
    name: 'Telegram',
    href: 'https://t.me/whyquran',
    icon: 'M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z'
  },
  {
    name: 'Twitter',
    href: 'https://twitter.com/whyquran',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z'
  }
];

const quickLinks = [
  { href: '/', label: 'Home' },
  { href: '/the-life-of-prophet-muhammad/', label: 'Seerah Series' },
  { href: '/blog/', label: 'All Episodes' },
  { href: '/subscribe/', label: 'Subscribe' },
];
---

<footer class="site-footer">
  <div class="footer-glow"></div>

  <div class="footer-container">
    <div class="footer-main">
      <div class="footer-brand">
        <a href="/" class="footer-logo">
          <span class="logo-text">Why Quran</span>
          <span class="logo-dot"></span>
        </a>
        <p class="footer-tagline">
          Quran tafsirs and Islamic lectures based on the teachings of the Ahlul Bayt
        </p>
      </div>

      <div class="footer-links">
        <h4>Quick Links</h4>
        <nav>
          {quickLinks.map(link => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
      </div>

      <div class="footer-social">
        <h4>Connect</h4>
        <div class="social-links">
          {socialLinks.map(social => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={social.name}
              class="social-link"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="copyright">
        &copy; {currentYear} Why Quran. All rights reserved.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary);
    color: var(--color-text-inverse);
    margin-top: auto;
    position: relative;
    overflow: hidden;
  }

  .footer-glow {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 200px;
    background: radial-gradient(
      ellipse at center,
      rgba(201, 124, 58, 0.15) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-6);
    position: relative;
  }

  .footer-main {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  /* Brand Section */
  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    margin-bottom: var(--space-4);
  }

  .footer-logo .logo-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-text-inverse);
  }

  .footer-logo .logo-dot {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  .footer-tagline {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.7;
    margin: 0;
  }

  /* Links Section */
  .footer-links h4,
  .footer-social h4 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
    margin-bottom: var(--space-4);
  }

  .footer-links nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-links a {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  /* Social Section */
  .social-links {
    display: flex;
    gap: var(--space-3);
  }

  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    color: rgba(255, 255, 255, 0.8);
    transition: all var(--transition-fast);
  }

  .social-link:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-2px);
  }

  .social-link svg {
    width: 18px;
    height: 18px;
  }

  /* Bottom Section */
  .footer-bottom {
    padding-top: var(--space-6);
    text-align: center;
  }

  .copyright {
    font-size: var(--text-xs);
    color: rgba(255, 255, 255, 0.5);
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .footer-container {
      padding: var(--space-10) var(--space-4) var(--space-4);
    }

    .footer-main {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      text-align: center;
    }

    .footer-brand {
      max-width: none;
    }

    .footer-logo {
      justify-content: center;
    }

    .footer-links nav {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-4);
    }

    .social-links {
      justify-content: center;
    }
  }
</style>
