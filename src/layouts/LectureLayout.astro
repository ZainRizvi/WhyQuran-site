---
import BaseLayout from './BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  date: Date;
  youtubeId?: string;
  videoDescription?: string;
  podcastUrl?: string;
  slides?: Array<{ name: string; url: string }>;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
}

const { title, date, youtubeId, videoDescription, podcastUrl, slides, prevPost, nextPost } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Description for SEO - use video description if available, otherwise default
const seoDescription = videoDescription || `${title} - Why Quran`;

// YouTube thumbnail for OG image
const ogImage = youtubeId
  ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`
  : undefined;

const hasResources = podcastUrl || (slides && slides.length > 0);
---

<BaseLayout title={title} description={seoDescription} ogImage={ogImage}>
  <article class="lecture">
    <header class="lecture-header">
      <div class="header-content">
        <div class="header-meta">
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{title}</h1>
      </div>
      <div class="header-decoration"></div>
    </header>

    <div class="lecture-body">
      <div class="main-content">
        <!-- Video Section -->
        {youtubeId && (
          <div class="video-section">
            <div class="video-wrapper">
              <YouTubeEmbed videoId={youtubeId} title={title} />
            </div>

            {hasResources && (
              <div class="resource-bar">
                {podcastUrl && (
                  <a href={podcastUrl} target="_blank" rel="noopener noreferrer" class="resource-link podcast">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="10"/>
                      <polygon points="10 8 16 12 10 16 10 8"/>
                    </svg>
                    <span class="resource-text">
                      <span class="resource-label">Listen</span>
                      <span class="resource-sublabel">Podcast</span>
                    </span>
                  </a>
                )}
                {slides && slides.length > 0 && slides.map((slide) => (
                  <a href={slide.url} class="resource-link slides" download>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                      <polyline points="14 2 14 8 20 8"/>
                      <line x1="12" y1="18" x2="12" y2="12"/>
                      <polyline points="9 15 12 18 15 15"/>
                    </svg>
                    <span class="resource-text">
                      <span class="resource-label">Download</span>
                      <span class="resource-sublabel">Slides</span>
                    </span>
                  </a>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- Description Sidebar -->
        {videoDescription && (
          <aside class="description-panel">
            <div class="description-header">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="16" x2="12" y2="12"/>
                <line x1="12" y1="8" x2="12.01" y2="8"/>
              </svg>
              <h2>About This Lecture</h2>
            </div>
            <div class="description-content">
              <p>{videoDescription}</p>
            </div>
            <div class="description-decoration"></div>
          </aside>
        )}
      </div>

      <!-- Additional Content Slot -->
      <div class="post-content">
        <slot />
      </div>

      <Navigation prevPost={prevPost} nextPost={nextPost} />
    </div>
  </article>
</BaseLayout>

<style>
  /* ============================================
     Lecture Layout - Scholarly Serenity
     ============================================ */

  .lecture {
    --lecture-max-width: 1400px;
    --content-gap: 2.5rem;
  }

  /* Header */
  .lecture-header {
    position: relative;
    background: linear-gradient(145deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: white;
    padding: 3.5rem 0 4rem;
    overflow: hidden;
  }

  .lecture-header::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 80%, rgba(184, 134, 11, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.05) 0%, transparent 40%);
    pointer-events: none;
  }

  .header-content {
    position: relative;
    max-width: var(--lecture-max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .header-meta time {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    opacity: 0.85;
    letter-spacing: 0.02em;
  }

  .lecture-header h1 {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.25;
    color: white;
    margin: 0;
    max-width: 900px;
  }

  .header-decoration {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(90deg,
      var(--color-accent) 0%,
      var(--color-accent-light) 50%,
      var(--color-accent) 100%
    );
  }

  /* Main Body */
  .lecture-body {
    max-width: var(--lecture-max-width);
    margin: 0 auto;
    padding: 0 2rem 3rem;
  }

  /* Main Content Grid */
  .main-content {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--content-gap);
    margin-top: -2rem;
    position: relative;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .main-content {
      grid-template-columns: 1fr 380px;
      align-items: start;
    }
  }

  /* Video Section */
  .video-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video-wrapper {
    background: #000;
    border-radius: 12px 12px 0 0;
    overflow: hidden;
    box-shadow:
      0 25px 50px -12px rgba(0, 0, 0, 0.25),
      0 0 0 1px rgba(0, 0, 0, 0.05);
  }

  .video-wrapper :global(.youtube-embed) {
    border-radius: 0;
  }

  /* Resource Bar */
  .resource-bar {
    display: flex;
    gap: 0;
    background: white;
    border-radius: 0 0 12px 12px;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.03);
    overflow: hidden;
  }

  .resource-link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
    padding: 1rem 1.5rem;
    color: var(--color-text);
    text-decoration: none;
    transition: all 0.25s ease;
    border-right: 1px solid var(--color-border);
  }

  .resource-link:last-child {
    border-right: none;
  }

  .resource-link svg {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .resource-link:hover svg {
    transform: scale(1.1);
  }

  .resource-text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .resource-label {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .resource-sublabel {
    font-size: 0.8rem;
    color: var(--color-text-light);
    line-height: 1.2;
  }

  .resource-link.podcast {
    background: linear-gradient(135deg, rgba(184, 134, 11, 0.08) 0%, rgba(184, 134, 11, 0.03) 100%);
  }

  .resource-link.podcast:hover {
    background: linear-gradient(135deg, rgba(184, 134, 11, 0.15) 0%, rgba(184, 134, 11, 0.08) 100%);
  }

  .resource-link.podcast svg {
    color: var(--color-accent);
  }

  .resource-link.slides {
    background: linear-gradient(135deg, rgba(13, 92, 99, 0.08) 0%, rgba(13, 92, 99, 0.03) 100%);
  }

  .resource-link.slides:hover {
    background: linear-gradient(135deg, rgba(13, 92, 99, 0.15) 0%, rgba(13, 92, 99, 0.08) 100%);
  }

  .resource-link.slides svg {
    color: var(--color-primary);
  }

  /* Description Panel */
  .description-panel {
    background: white;
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow:
      0 4px 20px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.03);
    position: relative;
    overflow: hidden;
  }

  @media (min-width: 1024px) {
    .description-panel {
      position: sticky;
      top: 100px;
    }
  }

  .description-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .description-header svg {
    width: 22px;
    height: 22px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .description-header h2 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text);
    letter-spacing: 0.01em;
  }

  .description-content p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text);
  }

  .description-decoration {
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: linear-gradient(180deg,
      var(--color-accent) 0%,
      var(--color-primary) 100%
    );
  }

  /* Post Content */
  .post-content {
    padding: 2rem 0;
    font-size: 1.125rem;
    line-height: 1.8;
  }

  .post-content:empty {
    display: none;
  }

  .post-content :global(p) {
    margin: 1.5rem 0;
  }

  .post-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    color: var(--color-primary-dark);
  }

  /* Mobile Responsive */
  @media (max-width: 768px) {
    .lecture-header {
      padding: 2.5rem 0 3rem;
    }

    .header-content {
      padding: 0 1.25rem;
    }

    .lecture-body {
      padding: 0 1.25rem 2rem;
    }

    .main-content {
      gap: 1.5rem;
      margin-top: -1.5rem;
    }

    .video-wrapper {
      border-radius: 10px 10px 0 0;
    }

    .resource-bar {
      border-radius: 0 0 10px 10px;
      flex-direction: column;
    }

    .resource-link {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
      justify-content: flex-start;
      padding: 1rem 1.25rem;
    }

    .resource-link:last-child {
      border-bottom: none;
    }

    .description-panel {
      padding: 1.5rem;
      border-radius: 10px;
    }
  }

  /* Animations */
  @media (prefers-reduced-motion: no-preference) {
    .video-section {
      animation: slideUp 0.5s ease-out;
    }

    .description-panel {
      animation: slideUp 0.5s ease-out 0.1s both;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
