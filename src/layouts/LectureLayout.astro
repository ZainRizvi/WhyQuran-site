---
import BaseLayout from './BaseLayout.astro';
import YouTubeEmbed from '../components/YouTubeEmbed.astro';
import Navigation from '../components/Navigation.astro';

interface Props {
  title: string;
  date: Date;
  youtubeId?: string;
  videoDescription?: string;
  podcastUrl?: string;
  slides?: Array<{ name: string; url: string }>;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
}

const { title, date, youtubeId, videoDescription, podcastUrl, slides, prevPost, nextPost } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Description for SEO - use video description if available, otherwise default
const seoDescription = videoDescription || `${title} - Why Quran`;

// YouTube thumbnail for OG image
const ogImage = youtubeId
  ? `https://img.youtube.com/vi/${youtubeId}/maxresdefault.jpg`
  : undefined;

const hasResources = podcastUrl || (slides && slides.length > 0);

// Format description: convert bullet points and preserve line breaks
function formatDescription(text: string): string {
  return text
    .split('\n')
    .map(line => {
      const trimmed = line.trim();
      if (trimmed.startsWith('- ')) {
        // Convert bullet points to list items
        return `<li>${trimmed.slice(2)}</li>`;
      } else if (trimmed) {
        return `<p>${trimmed}</p>`;
      }
      return '';
    })
    .join('')
    // Wrap consecutive <li> elements in <ul>
    .replace(/(<li>.*?<\/li>)+/g, '<ul>$&</ul>');
}

const formattedDescription = videoDescription ? formatDescription(videoDescription) : '';
---

<BaseLayout title={title} description={seoDescription} ogImage={ogImage}>
  <article class="lecture">
    <!-- Header -->
    <header class="lecture-header">
      <div class="header-bg">
        <div class="header-gradient"></div>
      </div>
      <div class="header-content">
        <div class="header-meta">
          <a href="/the-life-of-prophet-muhammad/" class="series-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            Seerah Series
          </a>
          <span class="meta-divider"></span>
          <time datetime={date.toISOString()}>{formattedDate}</time>
        </div>
        <h1>{title}</h1>
      </div>
    </header>

    <!-- Main Content -->
    <div class="lecture-body">
      <div class="content-wrapper">
        <!-- Video Section -->
        {youtubeId && (
          <section class="video-section">
            <div class="video-container">
              <YouTubeEmbed videoId={youtubeId} title={title} />
            </div>

            {hasResources && (
              <div class="resource-bar">
                {podcastUrl && (
                  <a href={podcastUrl} target="_blank" rel="noopener noreferrer" class="resource-link podcast">
                    <div class="resource-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                        <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                        <line x1="12" y1="19" x2="12" y2="23"/>
                        <line x1="8" y1="23" x2="16" y2="23"/>
                      </svg>
                    </div>
                    <div class="resource-text">
                      <span class="resource-label">Listen</span>
                      <span class="resource-sublabel">Podcast</span>
                    </div>
                  </a>
                )}
                {slides && slides.length > 0 && slides.map((slide) => (
                  <a href={slide.url} class="resource-link slides" download>
                    <div class="resource-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                      </svg>
                    </div>
                    <div class="resource-text">
                      <span class="resource-label">Download</span>
                      <span class="resource-sublabel">Slides</span>
                    </div>
                  </a>
                ))}
              </div>
            )}
          </section>
        )}

        <!-- Description Panel -->
        {videoDescription && (
          <aside class="description-panel">
            <div class="panel-header">
              <h2>About This Lecture</h2>
            </div>
            <div class="panel-content" set:html={formattedDescription} />
          </aside>
        )}
      </div>

      <!-- Additional Content Slot -->
      <div class="post-content">
        <slot />
      </div>

      <!-- Navigation -->
      <Navigation prevPost={prevPost} nextPost={nextPost} />
    </div>
  </article>
</BaseLayout>

<style>
  /* ============================================
     Lecture Layout
     ============================================ */
  .lecture {
    --content-max-width: 1200px;
  }

  /* Header */
  .lecture-header {
    position: relative;
    padding: var(--space-8) var(--space-6) var(--space-10);
    overflow: hidden;
  }

  .header-bg {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
  }

  .header-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 0%, rgba(201, 124, 58, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 100%, rgba(201, 124, 58, 0.1) 0%, transparent 50%);
  }

  .header-content {
    position: relative;
    max-width: var(--content-max-width);
    margin: 0 auto;
    z-index: 1;
  }

  .header-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .series-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .series-link:hover {
    color: var(--color-accent-light);
  }

  .series-link svg {
    width: 16px;
    height: 16px;
  }

  .meta-divider {
    width: 4px;
    height: 4px;
    background: rgba(255, 255, 255, 0.3);
    border-radius: 50%;
  }

  .header-meta time {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .lecture-header h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    color: white;
    margin: 0;
    max-width: 900px;
    line-height: 1.2;
  }

  /* Body */
  .lecture-body {
    max-width: var(--content-max-width);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-12);
  }

  /* Content Wrapper */
  .content-wrapper {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin-top: calc(-1 * var(--space-6));
    position: relative;
    z-index: 2;
  }

  @media (min-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr 360px;
      align-items: start;
    }
  }

  /* Video Section */
  .video-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .video-container {
    background: #000;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .video-container :global(.youtube-container) {
    margin: 0;
  }

  .video-container :global(lite-youtube) {
    border-radius: 0;
  }

  /* Resource Bar */
  .resource-bar {
    display: flex;
    background: var(--color-bg-card);
    border-radius: 0 0 var(--radius-xl) var(--radius-xl);
    box-shadow: var(--shadow-md);
    overflow: hidden;
  }

  .resource-link {
    flex: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    color: var(--color-text);
    transition: all var(--transition-fast);
    border-right: 1px solid var(--color-border);
  }

  .resource-link:last-child {
    border-right: none;
  }

  .resource-link:hover {
    background: var(--color-bg-alt);
  }

  .resource-icon {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    flex-shrink: 0;
    transition: transform var(--transition-fast);
  }

  .resource-link:hover .resource-icon {
    transform: scale(1.1);
  }

  .resource-icon svg {
    width: 22px;
    height: 22px;
  }

  .resource-link.podcast .resource-icon {
    background: var(--color-accent-glow);
    color: var(--color-accent);
  }

  .resource-link.slides .resource-icon {
    background: rgba(26, 31, 58, 0.08);
    color: var(--color-primary);
  }

  .resource-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .resource-label {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text);
  }

  .resource-sublabel {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* Description Panel */
  .description-panel {
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    box-shadow: var(--shadow-md);
    position: relative;
  }

  @media (min-width: 1024px) {
    .description-panel {
      position: sticky;
      top: 88px;
    }
  }

  .description-panel::before {
    content: '';
    position: absolute;
    left: 0;
    top: var(--space-6);
    bottom: var(--space-6);
    width: 3px;
    background: linear-gradient(180deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    border-radius: 0 2px 2px 0;
  }

  .panel-header {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .panel-header h2 {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0;
  }

  .panel-content {
    font-size: var(--text-base);
    line-height: 1.75;
    color: var(--color-text);
  }

  .panel-content :global(p) {
    margin: 0 0 var(--space-4);
  }

  .panel-content :global(p:last-child) {
    margin-bottom: 0;
  }

  .panel-content :global(ul) {
    margin: var(--space-3) 0;
    padding: 0;
    list-style: none;
  }

  .panel-content :global(li) {
    position: relative;
    padding-left: var(--space-5);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .panel-content :global(li:last-child) {
    margin-bottom: 0;
  }

  .panel-content :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
  }

  /* Post Content */
  .post-content {
    padding: var(--space-8) 0;
    font-size: var(--text-lg);
    line-height: 1.8;
  }

  .post-content:empty {
    display: none;
  }

  .post-content :global(p) {
    margin: var(--space-5) 0;
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    color: var(--color-accent-dark);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .lecture-header {
      padding: var(--space-6) var(--space-4) var(--space-8);
    }

    .lecture-header h1 {
      font-size: var(--text-2xl);
    }

    .lecture-body {
      padding: 0 var(--space-4) var(--space-8);
    }

    .content-wrapper {
      margin-top: calc(-1 * var(--space-4));
    }

    .video-container {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    }

    .resource-bar {
      flex-direction: column;
      border-radius: 0 0 var(--radius-lg) var(--radius-lg);
    }

    .resource-link {
      border-right: none;
      border-bottom: 1px solid var(--color-border);
    }

    .resource-link:last-child {
      border-bottom: none;
    }

    .description-panel {
      padding: var(--space-5);
      border-radius: var(--radius-lg);
    }
  }

  /* Animations */
  @media (prefers-reduced-motion: no-preference) {
    .video-section {
      animation: slideUp 0.5s ease-out;
    }

    .description-panel {
      animation: slideUp 0.5s ease-out 0.1s both;
    }

    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
