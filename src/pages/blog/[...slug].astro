---
import LectureLayout from '../../layouts/LectureLayout.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

interface EpisodeData {
  slug: string;
  title: string;
  videoId: string;
  description?: string;
  podcastUrl?: string;
  slidesUrl?: string;
  publishedDate: Date;
  episodeNum: number;
}

export function getStaticPaths() {
  // Helper to generate slug from title like "[58] Khandaq: Digging the Trench - Pt 2"
  function generateSlug(title: string): string {
    return title
      .replace(/^\[(\d+)\]\s*/, '$1-')  // [58] -> 58-
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, '-')      // Replace non-alphanumeric with dashes
      .replace(/-+/g, '-')              // Collapse multiple dashes
      .replace(/^-|-$/g, '');           // Trim leading/trailing dashes
  }

  // Load YAML data
  const dataPath = path.join(process.cwd(), 'src/data/series.yaml');
  const fileContents = fs.readFileSync(dataPath, 'utf8');
  const seriesData = yaml.load(fileContents) as {
    series: Array<{
      id: string;
      episodes: Array<{
        video_id: string;
        title: string;
        url: string;
        description?: string;
        podcast_episode_url?: string;
        slides_url?: string;
        published_date?: string;
      }>;
    }>;
  };

  const prophetSeries = seriesData.series.find(s => s.id === 'the-life-of-prophet-muhammad');
  const episodes: EpisodeData[] = [];

  if (prophetSeries) {
    prophetSeries.episodes.forEach((ep) => {
      const match = ep.title.match(/^\[(\d+)\]/);
      if (match) {
        const epNum = parseInt(match[1], 10);
        episodes.push({
          slug: generateSlug(ep.title),
          title: ep.title,
          videoId: ep.video_id,
          description: ep.description,
          podcastUrl: ep.podcast_episode_url,
          slidesUrl: ep.slides_url,
          publishedDate: ep.published_date ? new Date(ep.published_date) : new Date('2020-01-01'),
          episodeNum: epNum,
        });
      }
    });
  }

  // Sort by episode number for navigation
  episodes.sort((a, b) => a.episodeNum - b.episodeNum);

  return episodes.map((ep, index) => {
    const prevEp = index > 0 ? episodes[index - 1] : null;
    const nextEp = index < episodes.length - 1 ? episodes[index + 1] : null;

    return {
      params: { slug: ep.slug },
      props: {
        episode: ep,
        prevPost: prevEp ? { slug: prevEp.slug, title: prevEp.title } : undefined,
        nextPost: nextEp ? { slug: nextEp.slug, title: nextEp.title } : undefined,
      },
    };
  });
}

const { episode, prevPost, nextPost } = Astro.props;

// Build slides array if we have a URL
const slides = episode.slidesUrl
  ? [{ name: `Lecture ${episode.episodeNum} Slides`, url: episode.slidesUrl }]
  : undefined;
---

<LectureLayout
  title={episode.title}
  date={episode.publishedDate}
  youtubeId={episode.videoId}
  videoDescription={episode.description}
  podcastUrl={episode.podcastUrl}
  slides={slides}
  prevPost={prevPost}
  nextPost={nextPost}
/>
