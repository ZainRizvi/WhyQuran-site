---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found">
  <section class="not-found">
    <div class="not-found-bg">
      <div class="not-found-gradient"></div>
      <div class="not-found-pattern"></div>
    </div>

    <div class="not-found-content">
      <span class="error-code">404</span>
      <h1>Page Not Found</h1>
      <p>The page you're looking for doesn't exist or has been moved.</p>

      <div class="not-found-actions">
        <a href="/" class="btn btn-accent btn-lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
          </svg>
          Back to Home
        </a>
        <a href="/the-life-of-prophet-muhammad/" class="btn btn-outline btn-lg">
          Browse Seerah Series
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) var(--space-6);
    overflow: hidden;
  }

  .not-found-bg {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
  }

  .not-found-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(201, 124, 58, 0.15) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(201, 124, 58, 0.1) 0%, transparent 40%);
  }

  .not-found-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .not-found-content {
    position: relative;
    max-width: 600px;
    text-align: center;
    z-index: 1;
  }

  .error-code {
    display: block;
    font-family: var(--font-display);
    font-size: clamp(6rem, 20vw, 10rem);
    font-weight: 600;
    line-height: 1;
    color: rgba(255, 255, 255, 0.1);
    margin-bottom: var(--space-4);
  }

  .not-found-content h1 {
    font-size: var(--text-3xl);
    font-weight: 500;
    color: white;
    margin-bottom: var(--space-4);
  }

  .not-found-content p {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: var(--space-8);
  }

  .not-found-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .not-found-actions .btn svg {
    width: 18px;
    height: 18px;
  }

  .not-found-actions .btn-outline {
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
  }

  .not-found-actions .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  @media (max-width: 768px) {
    .not-found {
      min-height: 70vh;
      padding: var(--space-12) var(--space-4);
    }

    .not-found-content h1 {
      font-size: var(--text-2xl);
    }

    .not-found-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
