---
import BaseLayout from '../layouts/BaseLayout.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Helper to generate slug from title like "[58] Khandaq: Digging the Trench - Pt 2"
function generateSlug(title: string): string {
  return title
    .replace(/^\[(\d+)\]\s*/, '$1-')  // [58] -> 58-
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')      // Replace non-alphanumeric with dashes
    .replace(/-+/g, '-')              // Collapse multiple dashes
    .replace(/^-|-$/g, '');           // Trim leading/trailing dashes
}

// Extract episode number from title like "[1] Title" or "[89] Title"
function getEpisodeNumber(title: string): number | null {
  const match = title.match(/^\[(\d+)\]/);
  return match ? parseInt(match[1], 10) : null;
}

// Clean title by removing episode number prefix
function cleanTitle(title: string): string {
  return title.replace(/^\[\d+\]\s*/, '');
}

// Load series data from YAML
const dataPath = path.join(process.cwd(), 'src/data/series.yaml');
const fileContents = fs.readFileSync(dataPath, 'utf8');
const data = yaml.load(fileContents) as {
  channel: { name: string; youtube_url: string };
  series: Array<{
    id: string;
    title: string;
    description: string;
    speaker?: string;
    playlist_url: string;
    podcast_url?: string;
    thumbnail_video_id: string;
    episodes: Array<{ video_id: string; title: string; url: string }>;
  }>;
};

// Find the Prophet Muhammad series
const series = data.series.find(s => s.id === 'the-life-of-prophet-muhammad');
if (!series) {
  throw new Error('Series not found: the-life-of-prophet-muhammad');
}

const { episodes, playlist_url, podcast_url, speaker, description } = series;
---

<BaseLayout
  title="The Life of Prophet Muhammad"
  description={description}
>
  <!-- Hero Section -->
  <section class="series-hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-image">
        <img
          src={`https://img.youtube.com/vi/${series.thumbnail_video_id}/maxresdefault.jpg`}
          alt=""
          loading="eager"
        />
      </div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
        </span>
        Seerah Series
      </div>

      <h1>The Life of Prophet Muhammad</h1>
      <p class="hero-description">{description}</p>

      <div class="hero-meta">
        {speaker && (
          <div class="meta-item">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            <span>{speaker}</span>
          </div>
        )}
        <div class="meta-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="2" y="7" width="20" height="15" rx="2" ry="2"/>
            <polyline points="17 2 12 7 7 2"/>
          </svg>
          <span>{episodes.length} Episodes</span>
        </div>
      </div>

      <div class="hero-actions">
        {episodes.length > 0 && (
          <a href={`/blog/${generateSlug(episodes[0].title)}/`} class="btn btn-accent btn-lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
            Start from Episode 1
          </a>
        )}
        {podcast_url && (
          <a href={podcast_url} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-lg">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="23"/>
              <line x1="8" y1="23" x2="16" y2="23"/>
            </svg>
            Listen on Podcast
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Episodes Grid -->
  <section class="section episodes-section">
    <div class="container">
      <div class="section-header">
        <h2>All Episodes</h2>
        <p class="episode-count">{episodes.length} episodes in this series</p>
      </div>

      <div class="episodes-grid">
        {episodes.map((episode, index) => {
          const epNum = getEpisodeNumber(episode.title);
          const slug = epNum ? generateSlug(episode.title) : null;
          const href = slug ? `/blog/${slug}/` : episode.url;
          const isExternal = !slug;

          return (
            <article class="episode-card" style={`--delay: ${Math.min(index * 0.03, 0.5)}s`}>
              <a href={href} target={isExternal ? "_blank" : undefined} rel={isExternal ? "noopener noreferrer" : undefined} class="card-link">
                <div class="card-thumbnail">
                  <img
                    src={`https://img.youtube.com/vi/${episode.video_id}/mqdefault.jpg`}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="thumbnail-overlay">
                    <span class="play-icon">
                      <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </span>
                  </div>
                  {epNum && <span class="episode-number">{epNum}</span>}
                </div>
                <div class="card-content">
                  <h3 class="card-title">{cleanTitle(episode.title)}</h3>
                </div>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Resources Section -->
  <section class="section resources-section">
    <div class="container">
      <div class="resources-card">
        <div class="resources-content">
          <h2>Additional Resources</h2>
          <p>Access the full playlist and podcast feed</p>
          <div class="resources-links">
            <a href={playlist_url} target="_blank" rel="noopener noreferrer" class="resource-link">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>
                <strong>YouTube Playlist</strong>
                <small>Watch all episodes</small>
              </span>
            </a>
            {podcast_url && (
              <a href={podcast_url} target="_blank" rel="noopener noreferrer" class="resource-link">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                  <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                  <line x1="12" y1="19" x2="12" y2="23"/>
                  <line x1="8" y1="23" x2="16" y2="23"/>
                </svg>
                <span>
                  <strong>Podcast Feed</strong>
                  <small>Listen anywhere</small>
                </span>
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     Series Hero
     ============================================ */
  .series-hero {
    position: relative;
    min-height: 70vh;
    display: flex;
    align-items: center;
    padding: var(--space-16) var(--space-6);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(26, 31, 58, 0.98) 0%, rgba(26, 31, 58, 0.85) 50%, rgba(26, 31, 58, 0.7) 100%);
    z-index: 1;
  }

  .hero-image {
    position: absolute;
    inset: 0;
  }

  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.4;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: var(--max-width);
    margin: 0 auto;
    width: 100%;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(201, 124, 58, 0.2);
    border: 1px solid rgba(201, 124, 58, 0.3);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-accent);
    margin-bottom: var(--space-6);
  }

  .badge-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .badge-icon svg {
    width: 14px;
    height: 14px;
  }

  .series-hero h1 {
    font-size: var(--text-4xl);
    font-weight: 500;
    color: white;
    margin-bottom: var(--space-4);
    max-width: 700px;
  }

  .hero-description {
    font-size: var(--text-lg);
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    max-width: 600px;
    margin: 0 0 var(--space-6);
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    margin-bottom: var(--space-8);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  .meta-item svg {
    width: 18px;
    height: 18px;
    opacity: 0.7;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero-actions .btn svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     Episodes Section
     ============================================ */
  .episodes-section {
    background: var(--color-bg);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-8);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header h2 {
    margin: 0;
  }

  .episode-count {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    margin: 0;
  }

  .episodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: var(--space-5);
  }

  .episode-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    animation: fadeIn 0.4s ease-out both;
    animation-delay: var(--delay);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .episode-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-thumbnail {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary);
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .episode-card:hover .card-thumbnail img {
    transform: scale(1.05);
  }

  .thumbnail-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(26, 31, 58, 0.3);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .episode-card:hover .thumbnail-overlay {
    opacity: 1;
  }

  .play-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    border-radius: 50%;
    color: white;
    transform: scale(0.8);
    transition: transform var(--transition-bounce);
  }

  .episode-card:hover .play-icon {
    transform: scale(1);
  }

  .play-icon svg {
    width: 20px;
    height: 20px;
    margin-left: 2px;
  }

  .episode-number {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    min-width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 var(--space-2);
    background: var(--color-primary);
    color: white;
    font-size: var(--text-xs);
    font-weight: 700;
    border-radius: var(--radius-sm);
  }

  .card-content {
    padding: var(--space-4);
  }

  .card-title {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    margin: 0;
    color: var(--color-text);
    transition: color var(--transition-fast);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .episode-card:hover .card-title {
    color: var(--color-accent);
  }

  /* ============================================
     Resources Section
     ============================================ */
  .resources-section {
    background: var(--color-bg-alt);
    padding-bottom: var(--space-16);
  }

  .resources-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-sm);
  }

  .resources-content h2 {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-2);
  }

  .resources-content > p {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-6);
  }

  .resources-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .resource-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    background: var(--color-bg-alt);
    border-radius: var(--radius-lg);
    text-decoration: none;
    color: inherit;
    transition: all var(--transition-base);
    min-width: 240px;
  }

  .resource-link:hover {
    background: var(--color-accent-glow);
    transform: translateY(-2px);
  }

  .resource-link svg {
    width: 28px;
    height: 28px;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  .resource-link span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .resource-link strong {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--color-text);
  }

  .resource-link small {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ============================================
     Responsive
     ============================================ */
  @media (max-width: 768px) {
    .series-hero {
      min-height: auto;
      padding: var(--space-10) var(--space-4);
    }

    .series-hero h1 {
      font-size: var(--text-3xl);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .section-header {
      flex-direction: column;
      gap: var(--space-2);
    }

    .episodes-grid {
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: var(--space-4);
    }

    .resources-card {
      padding: var(--space-6);
    }

    .resources-links {
      flex-direction: column;
    }

    .resource-link {
      min-width: auto;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .episode-card {
      animation: none;
    }
  }
</style>
