---
import BaseLayout from '../layouts/BaseLayout.astro';
import yaml from 'js-yaml';
import fs from 'node:fs';
import path from 'node:path';

// Load series data from YAML
const dataPath = path.join(process.cwd(), 'src/data/series.yaml');
const fileContents = fs.readFileSync(dataPath, 'utf8');
const data = yaml.load(fileContents) as {
  channel: { name: string; youtube_url: string };
  series: Array<{
    id: string;
    title: string;
    surah_number?: number;
    description: string;
    speaker?: string;
    playlist_url: string;
    thumbnail_video_id: string;
    has_dedicated_page?: boolean;
    episodes: Array<{ video_id: string; title: string; url: string }>;
  }>;
};

const { series } = data;

// Featured series (the main seerah series)
const featuredSeries = series.find(s => s.id === 'the-life-of-prophet-muhammad');
const otherSeries = series.filter(s => s.id !== 'the-life-of-prophet-muhammad');
---

<BaseLayout title="Why Quran - Quran Tafsirs from the Ahlul Bayt">
  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-bg">
      <div class="hero-gradient"></div>
      <div class="hero-pattern"></div>
    </div>

    <div class="hero-content">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Islamic Education
      </div>

      <h1>Quran Tafsirs Based on the Teachings of the Ahlul Bayt</h1>

      <div class="hadith-card">
        <div class="hadith-decoration"></div>
        <blockquote>
          <p>
            "I am leaving among you two weighty things: the Book of Allah and my progeny,
            the Ahlul Bayt. If you hold fast to them, you will never go astray."
          </p>
          <footer>
            <cite>Prophet Muhammad</cite>
            <span>(peace be upon him and his family)</span>
          </footer>
        </blockquote>
      </div>

      <div class="hero-actions">
        <a href="#series" class="btn btn-accent btn-lg">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12l7 7 7-7"/>
          </svg>
          Explore Series
        </a>
      </div>
    </div>
  </section>

  <!-- Featured Series Section -->
  {featuredSeries && (
    <section id="series" class="section featured-section">
      <div class="container">
        <a href="/the-life-of-prophet-muhammad/" class="featured-card">
          <div class="featured-image">
            <img
              src={`https://img.youtube.com/vi/${featuredSeries.thumbnail_video_id}/maxresdefault.jpg`}
              alt={featuredSeries.title}
              loading="eager"
            />
          </div>
          <div class="featured-content">
            <span class="featured-label">Featured Series</span>
            <h3>{featuredSeries.title}</h3>
            <div class="featured-meta">
              <span class="episode-count">{featuredSeries.episodes.length} Episodes</span>
              <span class="speaker">{featuredSeries.speaker}</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- All Series Section -->
  <section class="section series-section">
    <div class="container">
      <div class="section-header">
        <span class="section-label">Video Library</span>
        <h2>Explore Our Series</h2>
        <p class="section-description">
          Scholarly teachings from the perspective of the Ahlul Bayt, covering Quran tafsir and Islamic history.
        </p>
      </div>

      <div class="series-grid">
        {otherSeries.map((s, index) => (
          <article class="series-card" style={`--delay: ${index * 0.05}s`}>
            <a
              href={s.has_dedicated_page ? `/${s.id}/` : s.playlist_url}
              class="card-link"
              target={s.has_dedicated_page ? undefined : "_blank"}
              rel={s.has_dedicated_page ? undefined : "noopener noreferrer"}
            >
              <div class="card-image">
                <img
                  src={`https://img.youtube.com/vi/${s.thumbnail_video_id}/mqdefault.jpg`}
                  alt={s.title}
                  loading="lazy"
                />
                <div class="card-overlay">
                  <span class="episode-badge">{s.episodes.length} episodes</span>
                </div>
                {s.surah_number && <span class="surah-badge">Surah {s.surah_number}</span>}
              </div>
              <div class="card-body">
                <h3>{s.title}</h3>
                {s.speaker && <span class="card-speaker">{s.speaker}</span>}
                <p class="card-description">{s.description}</p>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Subscribe Section -->
  <section class="section subscribe-section">
    <div class="container">
      <div class="subscribe-card">
        <div class="subscribe-content">
          <h2>Stay Updated</h2>
          <p>Subscribe to get notified when new lectures are published</p>
          <div class="subscribe-actions">
            <a
              href="https://www.youtube.com/@WhyQuran?sub_confirmation=1"
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-accent btn-lg"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              Subscribe on YouTube
            </a>
            <a href="https://t.me/whyquran" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg">
              <svg viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
                <path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/>
              </svg>
              Join Telegram
            </a>
          </div>
        </div>
        <div class="subscribe-decoration">
          <div class="decoration-ring"></div>
          <div class="decoration-ring"></div>
          <div class="decoration-ring"></div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ============================================
     Hero Section
     ============================================ */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-16) var(--space-6);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
  }

  .hero-gradient {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 30% 20%, rgba(201, 124, 58, 0.2) 0%, transparent 50%),
      radial-gradient(ellipse at 70% 80%, rgba(201, 124, 58, 0.15) 0%, transparent 40%),
      radial-gradient(ellipse at 50% 50%, rgba(42, 49, 84, 0.8) 0%, transparent 80%);
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-content {
    position: relative;
    max-width: 800px;
    text-align: center;
    z-index: 1;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
    margin-bottom: var(--space-6);
    backdrop-filter: blur(8px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.7; transform: scale(1.2); }
  }

  .hero h1 {
    font-size: var(--text-4xl);
    font-weight: 500;
    color: white;
    line-height: 1.15;
    margin-bottom: var(--space-8);
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
  }

  /* Hadith Card */
  .hadith-card {
    position: relative;
    max-width: 640px;
    margin: 0 auto var(--space-10);
    padding: var(--space-6) var(--space-8);
    background: rgba(255, 255, 255, 0.05);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hadith-decoration {
    position: absolute;
    left: 0;
    top: var(--space-4);
    bottom: var(--space-4);
    width: 4px;
    background: linear-gradient(180deg, var(--color-accent) 0%, var(--color-accent-dark) 100%);
    border-radius: 2px;
  }

  .hadith-card blockquote {
    margin: 0;
    text-align: left;
  }

  .hadith-card p {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 400;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.95);
    margin: 0 0 var(--space-4);
  }

  .hadith-card footer {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }

  .hadith-card cite {
    font-family: var(--font-body);
    font-style: normal;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .hadith-card footer span {
    font-size: var(--text-sm);
    color: rgba(255, 255, 255, 0.6);
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .hero-actions .btn svg {
    width: 18px;
    height: 18px;
  }

  /* ============================================
     Section Styles
     ============================================ */
  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--space-10);
  }

  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .section-header h2 {
    margin-bottom: var(--space-4);
  }

  .section-description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ============================================
     Featured Section
     ============================================ */
  .featured-section {
    background: var(--color-bg-alt);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
  }

  .featured-card {
    display: block;
    max-width: 480px;
    margin: 0 auto;
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    text-decoration: none;
    color: inherit;
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .featured-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary);
  }

  .featured-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .featured-content {
    padding: var(--space-5);
  }

  .featured-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .featured-content h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-3);
    transition: color var(--transition-fast);
  }

  .featured-card:hover .featured-content h3 {
    color: var(--color-accent);
  }

  .featured-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .episode-count {
    display: inline-flex;
    align-items: center;
    padding: var(--space-1) var(--space-2);
    background: var(--color-accent-glow);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
  }

  .speaker {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* ============================================
     Series Grid
     ============================================ */
  .series-section {
    background: var(--color-bg);
  }

  .series-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }

  .series-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
    animation: fadeInUp 0.5s ease-out both;
    animation-delay: var(--delay);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .series-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
  }

  .card-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .card-image {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .series-card:hover .card-image img {
    transform: scale(1.08);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(26, 31, 58, 0.8) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
  }

  .episode-badge {
    font-size: var(--text-xs);
    font-weight: 600;
    color: white;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .surah-badge {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    padding: var(--space-1) var(--space-3);
    background: var(--color-accent);
    color: white;
    font-size: var(--text-xs);
    font-weight: 600;
    border-radius: var(--radius-sm);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }

  .card-body {
    padding: var(--space-5) var(--space-5) var(--space-6);
  }

  .card-body h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin: 0 0 var(--space-2);
    transition: color var(--transition-fast);
  }

  .series-card:hover .card-body h3 {
    color: var(--color-accent);
  }

  .card-speaker {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }

  .card-description {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text-muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ============================================
     Subscribe Section
     ============================================ */
  .subscribe-section {
    background: var(--color-bg-alt);
  }

  .subscribe-card {
    position: relative;
    padding: var(--space-12) var(--space-10);
    background: var(--color-primary);
    border-radius: var(--radius-2xl);
    text-align: center;
    overflow: hidden;
  }

  .subscribe-content {
    position: relative;
    z-index: 1;
  }

  .subscribe-card h2 {
    color: white;
    margin-bottom: var(--space-3);
  }

  .subscribe-card p {
    color: rgba(255, 255, 255, 0.8);
    font-size: var(--text-lg);
    margin: 0 0 var(--space-8);
  }

  .subscribe-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }

  .subscribe-actions .btn svg {
    width: 20px;
    height: 20px;
  }

  .subscribe-actions .btn-outline {
    border-color: rgba(255, 255, 255, 0.3);
    color: white;
  }

  .subscribe-actions .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  .subscribe-decoration {
    position: absolute;
    top: 50%;
    right: -100px;
    transform: translateY(-50%);
  }

  .decoration-ring {
    position: absolute;
    border: 1px solid rgba(201, 124, 58, 0.2);
    border-radius: 50%;
  }

  .decoration-ring:nth-child(1) {
    width: 200px;
    height: 200px;
    top: -100px;
    left: -100px;
  }

  .decoration-ring:nth-child(2) {
    width: 300px;
    height: 300px;
    top: -150px;
    left: -150px;
  }

  .decoration-ring:nth-child(3) {
    width: 400px;
    height: 400px;
    top: -200px;
    left: -200px;
  }

  /* ============================================
     Responsive
     ============================================ */

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      padding: var(--space-12) var(--space-4);
    }

    .hero h1 {
      font-size: var(--text-3xl);
    }

    .hadith-card {
      padding: var(--space-4) var(--space-5);
    }

    .hadith-card p {
      font-size: var(--text-lg);
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .series-grid {
      grid-template-columns: 1fr;
    }

    .subscribe-card {
      padding: var(--space-8) var(--space-6);
    }

    .subscribe-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  /* Animation for reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    .series-card {
      animation: none;
    }

    .badge-dot {
      animation: none;
    }
  }
</style>
